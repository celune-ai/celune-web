{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "sync-vault": "node scripts/sync-vault.mjs",
    "lint-docs": "node scripts/lint-docs.mjs",
    "lint-docs:fix": "node scripts/lint-docs.mjs --fix",
    "dev": "node scripts/sync-vault.mjs && node scripts/lint-docs.mjs && next dev --port 3004 --webpack",
    "build": "node scripts/sync-vault.mjs && node scripts/lint-docs.mjs && cp instrumentation.ts .instrumentation.dev.ts && cp instrumentation.prod.ts instrumentation.ts && next build --webpack; s=$?; mv .instrumentation.dev.ts instrumentation.ts; exit $s",
    "start": "next start --port 3004",
    "lint": "eslint",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.6",
    "@repo/ui": "workspace:*",
    "@sentry/nextjs": "^11.10.0",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.3",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^7"
  }
}
