{
  "name": "celune-web",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "dev:site": "turbo dev --filter=site",
    "dev:docs": "turbo dev --filter=docs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.16",
      "js-yaml@4": "^4.3.2",
      "next>postcss": "^8.5.12",
      "flatted": "^3.4.2",
      "source-map-js": "^1.2.2",
      "dompurify": "^3.4.17",
      "zod@4": "^4.6.6"
    }
  }
}
